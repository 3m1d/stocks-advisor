# Database Configuration
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=stocks_advisor_db
DATABASE__USER=stocks_advisor_app_user
DATABASE__PASSWORD=stocks_advisor_app_password

# JWT auth
JWT__ADMIN_USERNAME=admin
JWT__ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$7BrYjo6KfyV7PktnKcXiag$7jcl43B7jU3ZDRUbOmQRz5i6z/wbt3XoLE0plXU1QrU  # admin
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=30

# MLflow (префикс MLFLOW__ → app.config.settings.mlflow; configure_mlflow() прокидывает S3 creds в os.environ)
MLFLOW__TRACKING_URI=http://localhost:5050
MLFLOW__DEFAULT_EXPERIMENT=stocks-advisor
MLFLOW__ARTIFACT_ROOT=s3://mlflow-bucket/mlflow
MLFLOW__S3_ENDPOINT_URL=http://localhost:9000
MLFLOW__AWS_ACCESS_KEY_ID=minioadmin
MLFLOW__AWS_SECRET_ACCESS_KEY=minioadmin
MLFLOW__AWS_REGION=us-east-1
MLFLOW__TRACKING_USERNAME=admin
MLFLOW__TRACKING_PASSWORD=admin
