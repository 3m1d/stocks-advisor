# Environment Variables for stocks-advisor
# Copy this file to .env and fill in your values
# .env file is gitignored and should not be committed

# Database Configuration
# Password is required - set it here or in DB_PASSWORD env var
DB_PASSWORD=your_database_password_here

# You can also override any TOML config value using nested syntax:
# APP__DEBUG=true
# APP__LOG_LEVEL=DEBUG
# DATABASE__HOST=localhost
# DATABASE__PORT=5432
# DATABASE__NAME=stocks_advisor
# DATABASE__USER=postgres
# MOEX__TIMEOUT_CONNECT=60
# API__HOST=127.0.0.1
# API__PORT=8080
